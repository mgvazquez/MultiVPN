<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Omarchy OpenVPN-Widget</vendor>

  <action id="software.nepomuk.multivpn.manage">
    <description>Manage OpenVPN client profiles</description>
    <description xml:lang="de">OpenVPN-Profile verwalten</description>
    <message>Authentication is required to manage OpenVPN client profiles.</message>
    <message xml:lang="de">Zum Verwalten der OpenVPN-Profile ist eine Authentifizierung nötig.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/multivpn-admin</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <!-- Connecting and disconnecting approved GlobalProtect portals. Its own
       action, so that a rule can allow exactly this without a password
       (49-multivpn-gp.rules) and nothing else: neither gpclient with options
       of the caller's choosing, nor approving portals, which takes sudo. -->
  <action id="software.nepomuk.multivpn.gp">
    <description>Connect an approved GlobalProtect portal</description>
    <description xml:lang="de">Freigegebenes GlobalProtect-Portal verbinden</description>
    <message>Authentication is required to connect or disconnect GlobalProtect.</message>
    <message xml:lang="de">Zum Verbinden oder Trennen von GlobalProtect ist eine Authentifizierung nötig.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/multivpn-gp</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
